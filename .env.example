# KHAN G Wholesale Ordering App — environment variables.
# Copy to .env (never commit .env). Values here are placeholders.

# --- Database (PostgreSQL / Supabase) ---------------------------------------
# Local dev without this: `npm run dev` starts an embedded PostgreSQL for you.
# Supabase: Project Settings -> Database -> Connection string (URI). Use the
# "Session pooler" or direct connection string; keep it server-side only.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/postgres

# --- Sessions ----------------------------------------------------------------
# Long random string (>= 32 chars), e.g.  openssl rand -base64 48
SESSION_SECRET=
# Set to true behind HTTPS (default: true when NODE_ENV=production)
COOKIE_SECURE=
NODE_ENV=development
PORT=8787

# --- First owner/admin account (created once if no admin exists) -------------
ADMIN_PHONE=
ADMIN_PASSWORD=
ADMIN_NAME=Owner

# --- Business defaults (editable later in Admin -> Settings) -----------------
BUSINESS_NAME=KHAN G
# WhatsApp number that receives click-to-chat orders, e.g. +923001234567
BUSINESS_WHATSAPP=

# --- Migrations / demo data --------------------------------------------------
AUTO_MIGRATE=true
# true = load ~190 demo products, demo shops and orders when the products table is empty
SEED_DEMO=false

# --- Weekly reminders ---------------------------------------------------------
# Node server checks every N seconds (0 disables the in-process scheduler).
REMINDER_INTERVAL_SECONDS=300
# Protects POST /api/cron/reminders for an external scheduler (Cloudflare cron, cron-job.org…)
CRON_SECRET=

# --- Production failure alerts (optional) -------------------------------------
# DevBench notify endpoint: errors (HTTP 500s, reminder job failures) are posted to the team chat.
DEVBENCH_NOTIFY_URL=
DEVBENCH_NOTIFY_TOKEN=
